{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // electron-vite BUNDLES main/preload, so module semantics are the
    // bundler's, not NodeNext's — override the base accordingly.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {
      "@mcpeasy/schema": ["../../packages/schema/src/index.ts"],
      "@mcpeasy/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.d.mts",
    "test/browserZip.test.ts",
    "test/claudeCode.test.ts",
    "test/ensureElectron.test.ts",
    "test/exportZip.test.ts",
    "test/projects.test.ts",
    "test/serveMode.test.ts"
  ]
}
